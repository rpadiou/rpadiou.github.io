#!/bin/sh
# Versioned pre-push hook. Install once with:  git config core.hooksPath scripts/hooks
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
python3 scripts/make_sitemap.py || exit 1
if ! git diff --quiet -- sitemap.xml; then
  echo "pre-push: sitemap.xml a été régénéré. Commitez-le (git commit -am 'Update sitemap') puis relancez le push." >&2
  exit 1
fi
python3 scripts/site_check.py || { echo "pre-push: push bloqué (erreurs ci-dessus)." >&2; exit 1; }
